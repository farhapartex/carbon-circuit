ENVIRONMENT=development
LOG_LEVEL=info
GRPC_ADDRESS=:9095

SHUTDOWN_TIMEOUT=20s
HEALTH_INTERVAL=10s

DATABASE_DSN=postgres://evidence_service:evidence_service@pgbouncer:6432/evidence?sslmode=disable
DATABASE_SCHEMA=evidence
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_ACQUIRE_TIMEOUT=250ms

STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=carboncircuit
STORAGE_SECRET_KEY=carboncircuit
STORAGE_BUCKET=carboncircuit-evidence
STORAGE_USE_TLS=false
DOWNLOAD_LINK_TTL=5m

SCANNER_KIND=none
SCANNER_ADDRESS=

MAXIMUM_BYTE_SIZE=26214400
MAXIMUM_PAGE_COUNT=100

KAFKA_BROKERS=kafka:9092
KAFKA_ALLOW_TOPIC_CREATE=true
OUTBOX_INTERVAL=1s
OUTBOX_BATCH_SIZE=100

SERVICE_TOKEN_PUBLIC_KEY=generate-with-go-run-./cmd/devkeys
TLS_CA_FILE=/certs/ca.crt
TLS_CERT_FILE=/certs/evidence-service.crt
TLS_KEY_FILE=/certs/evidence-service.key
