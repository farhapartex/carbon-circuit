ENVIRONMENT=development
LOG_LEVEL=info
GRPC_ADDRESS=:9093

SHUTDOWN_TIMEOUT=20s
HEALTH_INTERVAL=10s

DATABASE_DSN=postgres://provenance_service:provenance_service@pgbouncer:6432/provenance?sslmode=disable
DATABASE_SCHEMA=provenance
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_ACQUIRE_TIMEOUT=250ms

REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=
REDIS_DATABASE=0

IDENTITY_ADDRESS=identity-service:9091
CALL_TIMEOUT=2s

SERVICE_TOKEN_PUBLIC_KEY=generate-with-go-run-./cmd/devkeys
TLS_CA_FILE=/certs/ca.crt
TLS_CERT_FILE=/certs/provenance-service.crt
TLS_KEY_FILE=/certs/provenance-service.key
