ENVIRONMENT=development
LOG_LEVEL=info
GRPC_ADDRESS=:9094

SHUTDOWN_TIMEOUT=20s
HEALTH_INTERVAL=10s

DATABASE_DSN=postgres://provenance_read_service:provenance_read_service@pgbouncer:6432/provenance_read?sslmode=disable
DATABASE_SCHEMA=provenance_read
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_ACQUIRE_TIMEOUT=250ms

REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=
REDIS_DATABASE=0

KAFKA_BROKERS=kafka:9092
CONSUMER_GROUP=provenance-read

SERVICE_TOKEN_PUBLIC_KEY=generate-with-go-run-./cmd/devkeys
TLS_CA_FILE=/certs/ca.crt
TLS_CERT_FILE=/certs/provenance-read-service.crt
TLS_KEY_FILE=/certs/provenance-read-service.key
