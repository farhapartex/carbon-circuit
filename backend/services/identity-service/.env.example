ENVIRONMENT=development
LOG_LEVEL=info
HTTP_ADDRESS=:8081

READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
SHUTDOWN_TIMEOUT=20s

DATABASE_DSN=postgres://identity_service:identity_service@pgbouncer:6432/identity?sslmode=disable
DATABASE_SCHEMA=identity
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_ACQUIRE_TIMEOUT=250ms
