ENVIRONMENT=development
LOG_LEVEL=info
GRPC_ADDRESS=:9096

SHUTDOWN_TIMEOUT=20s
HEALTH_INTERVAL=10s

DATABASE_DSN=postgres://sustainability_service:sustainability_service@pgbouncer:6432/sustainability?sslmode=disable
DATABASE_SCHEMA=sustainability
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_ACQUIRE_TIMEOUT=250ms

IDENTITY_ADDRESS=identity-service:9091
EVIDENCE_ADDRESS=evidence-service:9095
CALL_TIMEOUT=2s

KAFKA_BROKERS=kafka:9092
CONSUMER_GROUP=sustainability
AI_REVIEW_STUB=true
KAFKA_ALLOW_TOPIC_CREATE=true
OUTBOX_INTERVAL=1s
OUTBOX_BATCH_SIZE=100

SERVICE_TOKEN_PUBLIC_KEY=generate-with-go-run-./cmd/devkeys
TLS_CA_FILE=/certs/ca.crt
TLS_CERT_FILE=/certs/sustainability-service.crt
TLS_KEY_FILE=/certs/sustainability-service.key
