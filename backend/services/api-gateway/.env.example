ENVIRONMENT=development
LOG_LEVEL=info
HTTP_ADDRESS=:8080

READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
SHUTDOWN_TIMEOUT=20s

IDENTITY_SERVICE_ADDRESS=identity-service:9091
UPSTREAM_DIAL_TIMEOUT=5s
UPSTREAM_CALL_TIMEOUT=2s
BILLING_SERVICE_ADDRESS=billing-service:9092

REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=
REDIS_DATABASE=0

PUBLIC_READ_PER_MINUTE=60
PUBLIC_READ_BURST=20
PORTAL_USER_PER_MINUTE=300
PORTAL_USER_BURST=60

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.carboncircuit.dev
AUTH0_KEY_CACHE_TTL=5m
REVOCATION_WINDOW=15m

SERVICE_TOKEN_SEED=generate-with-go-run-./cmd/devkeys
SERVICE_TOKEN_LIFETIME=30s
CALLER_CONTEXT_TTL=60s
TLS_CA_FILE=/certs/ca.crt
TLS_CERT_FILE=/certs/api-gateway.crt
TLS_KEY_FILE=/certs/api-gateway.key
PROVENANCE_SERVICE_ADDRESS=provenance-service:9093
